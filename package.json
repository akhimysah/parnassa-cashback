{
  "name": "parnassa-cashback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parnassa Cashback — offres partenaires, cashback sur achats, paliers de fidélité, parrainage et versement sur le compte Parnassa.",
  "scripts": {
    "dev": "vite --port 5220",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5220",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/leaflet": "1.9.12",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.12.4"
}
